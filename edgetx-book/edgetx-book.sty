\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{edgetx-book}[2026/09/26 Оформление книги по EdgeTX]

% ---------- Язык и шрифты ----------
% Основной набор — как в курсе ESP32-S3 (Cambria/Calibri/Consolas).
% Если этих шрифтов нет (Linux, macOS), берутся свободные Liberation/DejaVu.
\RequirePackage{fontspec}
\RequirePackage{polyglossia}
\setdefaultlanguage{russian}
\setotherlanguage{english}
\IfFontExistsTF{Cambria}{%
  \setmainfont{Cambria}
  \setsansfont{Calibri}
  \setmonofont{Consolas}[Scale=0.92]
  \newfontfamily\cyrillicfont{Cambria}[Ligatures=TeX]
  \newfontfamily\cyrillicfontsf{Calibri}[Ligatures=TeX]
  \newfontfamily\cyrillicfonttt{Consolas}[Scale=0.92]
}{%
  \setmainfont{Liberation Serif}
  \setsansfont{Liberation Sans}
  \setmonofont{DejaVu Sans Mono}[Scale=0.85]
  \newfontfamily\cyrillicfont{Liberation Serif}[Ligatures=TeX]
  \newfontfamily\cyrillicfontsf{Liberation Sans}[Ligatures=TeX]
  \newfontfamily\cyrillicfonttt{DejaVu Sans Mono}[Scale=0.85]
}

% ---------- Вёрстка ----------
\RequirePackage[margin=2.2cm,top=2.4cm,bottom=2.4cm]{geometry}
\RequirePackage{microtype}
\setlength{\emergencystretch}{2.5em}
\RequirePackage{amsmath}
\RequirePackage{booktabs,tabularx,array,longtable}
\RequirePackage{enumitem}
\setlist{itemsep=2pt,topsep=4pt}
\RequirePackage{xcolor}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage{fancyhdr}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{float}
\RequirePackage{caption}
\captionsetup{font=small,labelfont={bf,sf}}
\RequirePackage{etoolbox,needspace}
\pretocmd{\section}{\needspace{10\baselineskip}}{}{}
\RequirePackage[most]{tcolorbox}

% ---------- Графика ----------
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,shapes.geometric,shapes.misc,fit,backgrounds,decorations.pathreplacing}
\RequirePackage{pgfplots}
\RequirePackage{siunitx}
\sisetup{output-decimal-marker={,},range-phrase={\,--\,},range-units=single}
\pgfplotsset{compat=1.18}

% ---------- Цвета ----------
\definecolor{etx}{HTML}{1A5276}      % основной (тёмно-синий)
\definecolor{etxdark}{HTML}{0B2F4A}
\definecolor{accent}{HTML}{D35400}   % оранжевый акцент
\definecolor{okgreen}{HTML}{1E8449}
\definecolor{warn}{HTML}{C0392B}
\definecolor{codebg}{HTML}{F5F7F9}
\definecolor{lcdbg}{HTML}{C9D8B6}    % «зелёный» монохромный ЖК
\definecolor{lcdfg}{HTML}{1C2A12}
\definecolor{blkin}{HTML}{D6EAF8}
\definecolor{blkmix}{HTML}{FCF3CF}
\definecolor{blkout}{HTML}{D5F5E3}
\definecolor{blkrf}{HTML}{FADBD8}
\definecolor{blksw}{HTML}{E8DAEF}

% ---------- Заголовки ----------
\titleformat{\chapter}[display]
  {\sffamily\bfseries\color{etxdark}\raggedright}
  {\large\color{accent}\MakeUppercase{Глава} \thechapter}
  {2mm}
  {\Huge}
  [{\color{accent}\titlerule[1.4pt]}]
\titlespacing*{\chapter}{0pt}{-10pt}{18pt}
\titleformat{\section}{\sffamily\Large\bfseries\color{etx}}{\thesection}{0.6em}{}
\titleformat{\subsection}{\sffamily\large\bfseries\color{etxdark}}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\sffamily\normalsize\bfseries}{}{0em}{}
\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{1}

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\sffamily\small\color{gray}EdgeTX на RadioMaster TX12 и Boxer}
\fancyhead[R]{\sffamily\small\color{gray}\nouppercase{\leftmark}}
\fancyfoot[C]{\sffamily\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\chaptermark}[1]{\markboth{\thechapter. #1}{}}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\sffamily\small\thepage}\renewcommand{\headrulewidth}{0pt}}

% ---------- Код (Lua, структура папок) ----------
\RequirePackage{fvextra}
\DefineVerbatimEnvironment{Code}{Verbatim}{
  fontsize=\small, numbers=left, numbersep=6pt, xleftmargin=14pt,
  frame=leftline, framerule=1.2pt, rulecolor=\color{etx!50},
  breaklines, tabsize=2,
}
\newcommand{\luafile}[1]{\VerbatimInput[fontsize=\small,numbers=left,numbersep=6pt,
  xleftmargin=14pt,frame=leftline,framerule=1.2pt,rulecolor=\color{etx!50},breaklines,tabsize=2]{lua/#1}}

% ---------- Боксы ----------
\newtcolorbox{chapintro}{enhanced,colback=etx!5,colframe=etx,boxrule=0.8pt,arc=2pt,
  left=6pt,right=6pt,top=5pt,bottom=5pt}
\newcommand{\introlabel}[1]{\textsf{\bfseries\textcolor{etx}{#1}}}
% \chapterintro{что узнаете}{что понадобится}
\newcommand{\chapterintro}[2]{%
\begin{chapintro}
\renewcommand{\arraystretch}{1.25}
\begin{tabularx}{\linewidth}{@{}p{27mm} X@{}}
\introlabel{В этой главе} & #1\\
\introlabel{Понадобится} & #2
\end{tabularx}
\end{chapintro}}
\newtcolorbox{caution}{enhanced,colback=warn!6,colframe=warn,fonttitle=\sffamily\bfseries,
  title=Осторожно,boxrule=0.8pt,arc=2pt,left=6pt,right=6pt}
\newtcolorbox{tip}{enhanced,colback=gray!6,colframe=gray!60,fonttitle=\sffamily\bfseries,
  title=Совет,boxrule=0.8pt,arc=2pt,left=6pt,right=6pt}
\newtcolorbox{note}{enhanced,colback=accent!5,colframe=accent,fonttitle=\sffamily\bfseries,
  title=На заметку,boxrule=0.8pt,arc=2pt,left=6pt,right=6pt}
\newtcolorbox{recipe}[1]{enhanced,colback=okgreen!4,colframe=okgreen,fonttitle=\sffamily\bfseries,
  title={Рецепт: #1},boxrule=0.8pt,arc=2pt,left=6pt,right=6pt,breakable}
\newtcolorbox{summary}{enhanced,colback=okgreen!5,colframe=okgreen,fonttitle=\sffamily\bfseries,
  title=Итоги главы,boxrule=0.8pt,arc=2pt,left=6pt,right=6pt}
\newtcolorbox{tasks}{enhanced,colback=etx!4,colframe=etx,fonttitle=\sffamily\bfseries,
  title=Практикум,boxrule=0.8pt,arc=2pt,left=6pt,right=6pt}

% ---------- Разметка интерфейса ----------
\newcommand{\code}[1]{\texttt{#1}}
\newcommand{\chkbox}{{\setlength{\fboxsep}{0pt}\setlength{\fboxrule}{0.8pt}\fbox{\rule{0pt}{2.2mm}\hspace{2.2mm}}}}
% Физическая кнопка пульта
\newcommand{\btn}[1]{\tikz[baseline=(k.base)]\node[k,draw=etx!70,fill=etx!8,rounded corners=1.5pt,
  inner sep=1.6pt,font=\sffamily\scriptsize\bfseries] (k) {#1};}
% Пункт меню / параметр EdgeTX (как на экране)
\newcommand{\menu}[1]{\textsf{\small\color{etxdark}#1}}
% Путь по меню: \path{SYS}{Hardware}{Calibration}
\newcommand{\mpath}[1]{\textsf{\small\color{etxdark}#1}}
\newcommand{\sep}{\,\textcolor{accent}{$\triangleright$}\,}
% Переключатель / источник
\newcommand{\sw}[1]{\textsf{\bfseries #1}}

\tikzset{
  k/.style={},
  blk/.style={draw,rounded corners=2pt,align=center,font=\sffamily\small,minimum height=8mm,inner sep=3pt},
  arr/.style={-{Stealth[length=2.2mm]},thick},
  darr/.style={{Stealth[length=2.2mm]}-{Stealth[length=2.2mm]},thick},
  lbl/.style={font=\sffamily\scriptsize,inner sep=1pt},
}

% Имитация монохромного экрана 128×64: \lcd{строки}
\newcommand{\lcd}[1]{%
\begin{tikzpicture}
  \node[draw=black!70,line width=1pt,fill=lcdbg,rounded corners=2pt,inner sep=4pt,
        text=lcdfg,font=\ttfamily\footnotesize,align=left,text width=62mm] {#1};
\end{tikzpicture}}
\newcommand{\inv}[1]{\colorbox{lcdfg}{\textcolor{lcdbg}{#1}}}

% ---------- Приложения ----------
\newcommand{\bookappendix}{%
  \appendix
  \titleformat{\chapter}[display]
    {\sffamily\bfseries\color{etxdark}}
    {\large\color{accent}\MakeUppercase{Приложение} \thechapter}
    {2mm}{\Huge}[{\color{accent}\titlerule[1.4pt]}]%
}

