% ---------- Заголовки ----------
\titleformat{\section}{\sffamily\LARGE\bfseries\color{espdark}}{Урок \thesection.}{0.6em}{}[{\color{esp}\titlerule[1.2pt]}]
\titleformat{\subsection}{\sffamily\large\bfseries\color{accent}}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\sffamily\normalsize\bfseries}{}{0em}{}
% уроки нумеруются с 1

\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\sffamily\small\color{gray}ESP32-S3 для начинающих}
\fancyhead[R]{\sffamily\small\color{gray}\nouppercase{\leftmark}}
\fancyfoot[C]{\sffamily\small\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\sectionmark}[1]{\markboth{Урок \thesection. #1}{}}

% ---------- Листинги ----------
% Код подсвечен заранее скриптом highlight.py (Pygments): code/имя.cpp -> code/имя.tex
\RequirePackage{fvextra}
\RequirePackage{newfloat}
\DeclareFloatingEnvironment[name=Листинг,fileext=lol]{listing}
\input{code/pygments-style.tex}
% Фон листинга рисует tcolorbox: так работает и со старыми версиями fvextra (без bgcolor)
\newenvironment{CodeVerbatim}{%
  \VerbatimEnvironment
  \begin{tcolorbox}[enhanced,breakable,colback=codebg,colframe=codebg,boxrule=0pt,arc=0pt,
    left=4pt,right=4pt,top=2pt,bottom=2pt]%
  \begin{Verbatim}[commandchars=\\\{\},fontsize=\small,breaklines,tabsize=2]}%
 {\end{Verbatim}\end{tcolorbox}}
\newcommand{\codeinput}[1]{\input{code/#1.tex}}
\newcommand{\codecap}[1]{\needspace{8\baselineskip}\captionof{listing}{#1}}

% ---------- Боксы ----------
\newtcolorbox{introbox}{enhanced,colback=accent!5,colframe=accent,boxrule=0.8pt,arc=2pt,
  left=6pt,right=6pt,top=5pt,bottom=5pt}
\newcommand{\introlabel}[1]{\textsf{\bfseries\textcolor{accent}{#1}}}
\newcommand{\lessonintro}[4]{%
\begin{introbox}
\renewcommand{\arraystretch}{1.25}
\begin{tabularx}{\linewidth}{@{}p{27mm} X@{}}
\introlabel{Цель} & #1\\
\introlabel{Опирается на} & #2\\
\introlabel{Практика} & #3\\
\introlabel{Понадобится} & #4
\end{tabularx}
\end{introbox}}
\newtcolorbox{caution}{enhanced,colback=warn!8,colframe=warn,fonttitle=\sffamily\bfseries,
  title=Осторожно,boxrule=0.8pt,arc=2pt,left=6pt,right=6pt}
\newtcolorbox{tip}{enhanced,colback=gray!6,colframe=gray!60,fonttitle=\sffamily\bfseries,
  title=Совет,boxrule=0.8pt,arc=2pt,left=6pt,right=6pt}
\newtcolorbox{summary}{enhanced,colback=okgreen!5,colframe=okgreen,fonttitle=\sffamily\bfseries,
  title=Итоги урока,boxrule=0.8pt,arc=2pt,left=6pt,right=6pt}
\newtcolorbox{tasks}{enhanced,colback=esp!4,colframe=esp,fonttitle=\sffamily\bfseries,
  title=Задания для самостоятельной работы,boxrule=0.8pt,arc=2pt,left=6pt,right=6pt}
\newtcolorbox{fact}{enhanced,colback=blkrtc!35,colframe=blkrtc!50!black,fonttitle=\sffamily\bfseries,
  title=Это интересно,boxrule=0.8pt,arc=2pt,left=6pt,right=6pt}
\newtcolorbox{quiz}{enhanced,colback=accent!4,colframe=accent!70,fonttitle=\sffamily\bfseries,
  title=Проверь себя,boxrule=0.8pt,arc=2pt,left=6pt,right=6pt}

% Рисунок из двух частей: монтажная схема (на макетной плате) и принципиальная схема.
% \begin{twoview}{подпись}{метка} <монтажная> \nextview <принципиальная> \end{twoview}
\newenvironment{twoview}[2]{%
  \def\twoviewcap{#1}\def\twoviewlabel{#2}%
  \begin{figure}[H]\centering
  \begin{subfigure}{\textwidth}\centering}{%
  \caption{Принципиальная электрическая схема}
  \end{subfigure}
  \caption{\twoviewcap}\label{\twoviewlabel}
  \end{figure}}
\newcommand{\nextview}{%
  \caption{Монтажная схема: как собрать на макетной плате}
  \end{subfigure}\par\medskip
  \begin{subfigure}{\textwidth}\centering}

