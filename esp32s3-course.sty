\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{esp32s3-course}[2026/09/29 Оформление курса ESP32-S3]

% ---------- Язык и шрифты ----------
\RequirePackage{fontspec}
\RequirePackage{polyglossia}
\setdefaultlanguage{russian}
\setotherlanguage{english}
% Шрифты Windows (Cambria, Calibri, Consolas); если их нет --- свободные PT Serif, PT Sans, DejaVu Sans Mono
\IfFontExistsTF{Cambria}{\def\coursemain{Cambria}}{\def\coursemain{PT Serif}}
\IfFontExistsTF{Calibri}{\def\coursesans{Calibri}}{\def\coursesans{PT Sans}}
\IfFontExistsTF{Consolas}{\def\coursemono{Consolas}}{\def\coursemono{DejaVu Sans Mono}}
\setmainfont{\coursemain}
\setsansfont{\coursesans}
\setmonofont{\coursemono}[Scale=0.88]
\newfontfamily\cyrillicfont{\coursemain}[Ligatures=TeX]
\newfontfamily\cyrillicfontsf{\coursesans}[Ligatures=TeX]
\newfontfamily\cyrillicfonttt{\coursemono}[Scale=0.88]

% Символы, которых нет в части шрифтов
\RequirePackage{newunicodechar}
\newunicodechar{→}{\ensuremath{\rightarrow}}
\newunicodechar{■}{\rule[0.1ex]{0.9ex}{0.9ex}}

% ---------- Вёрстка ----------
\RequirePackage[margin=2.2cm,top=2.4cm,bottom=2.4cm]{geometry}
\RequirePackage{microtype}
\RequirePackage{amsmath}
\RequirePackage{booktabs,tabularx,array}
\RequirePackage{enumitem}
\RequirePackage{multicol}
\setlist{itemsep=2pt,topsep=4pt}
\RequirePackage{xcolor}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{float}
\RequirePackage{caption}
\captionsetup{font=small,labelfont={bf,sf}}
\RequirePackage{subcaption}
\renewcommand{\thesubfigure}{\ifcase\value{subfigure}\or а\or б\or в\or г\or д\fi}
\DeclareCaptionLabelFormat{rparen}{#2)}
\captionsetup[subfigure]{labelformat=rparen,labelsep=space,font=small}
\renewcommand{\p@subfigure}{\thefigure}

% ---------- Графика ----------
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,shapes.geometric,shapes.misc,fit,backgrounds,decorations.pathreplacing}
