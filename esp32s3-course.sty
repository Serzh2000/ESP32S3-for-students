% Индикатор прогресса проекта: \progress{номер шага}
\newcommand{\progress}[1]{%
\begin{center}
\begin{tikzpicture}[x=11mm]
  \node[anchor=east,font=\sffamily\scriptsize\bfseries,text=okgreen] at (0.85,0.17) {Умная лампа:};
  \foreach \i/\l in {1/LED,2/Serial,3/кнопка,4/ШИМ,5/ручка,6/экран,7/задачи,8/Wi-Fi,9/сон}{
    \ifnum\i>#1\relax \def\c{white}\def\t{gray}\else\def\c{okgreen!55}\def\t{black}\fi
    \draw[fill=\c,draw=okgreen,rounded corners=1pt] (\i,0) rectangle ++(0.9,0.34);
    \node[font=\sffamily\tiny,text=\t] at (\i+0.45,0.17) {\i};
    \node[font=\sffamily\tiny,text=\t] at (\i+0.45,-0.18) {\l};
  }
\end{tikzpicture}
\end{center}}

