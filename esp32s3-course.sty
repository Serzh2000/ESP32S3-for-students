% Рисунок из двух частей: монтажная схема (на макетной плате) и принципиальная схема.
% \begin{twoview}{подпись}{метка} <монтажная> \nextview <принципиальная> \end{twoview}
\newenvironment{twoview}[2]{%
  \def\twoviewcap{#1}\def\twoviewlabel{#2}%
  \begin{figure}[H]\centering
  \begin{subfigure}{\textwidth}\centering}{%
  \caption{Принципиальная электрическая схема}
  \end{subfigure}
  \caption{\twoviewcap}\label{\twoviewlabel}
  \end{figure}}
\newcommand{\nextview}{%
  \caption{Монтажная схема: как собрать на макетной плате}
  \end{subfigure}\par\medskip
  \begin{subfigure}{\textwidth}\centering}

